# Paketlotse Backend – Umgebungsvariablen (Kopie als .env, nicht einchecken)

PORT=8787
DATABASE_PATH=./data/paketlotse.sqlite

# Tracking-Anbieter (ohne beide Keys läuft automatisch der Mock-Anbieter)
# DHL Shipment Tracking – Unified: https://developer.dhl.com (kostenlos)
DHL_API_KEY=
# Ship24 (Hermes, DPD, GLS, UPS): https://www.ship24.com
SHIP24_API_KEY=
# Frei gewähltes Geheimnis; in Ship24 als Webhook-Header „Authorization: Bearer <secret>“ hinterlegen
SHIP24_WEBHOOK_SECRET=

# Mock erzwingen (Entwicklung): Sendungen laufen in ~6 Minuten von „angemeldet“ bis „zugestellt“
USE_MOCK_PROVIDER=false

# Push (APNs) – Apple Developer → Keys → „Apple Push Notifications service“
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=de.paketlotse.app
# Inhalt der .p8-Datei, Zeilenumbrüche als \n
APNS_PRIVATE_KEY=
# true = Produktions-APNs (TestFlight/App Store), false = Sandbox (Xcode-Builds)
APNS_PRODUCTION=false

POLL_INTERVAL_SECONDS=300
MAX_ACTIVE_SHIPMENTS=30
RETENTION_DAYS=30
