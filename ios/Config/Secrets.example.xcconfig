// Kopieren nach Config/Secrets.xcconfig (wird von git ignoriert) und Werte eintragen.

// Deine Team-ID: Xcode → Einstellungen → Accounts → Team auswählen,
// oder developer.apple.com → Account → Membership details → „Team ID“.
DEVELOPMENT_TEAM = ABCDE12345

// Optional: DHL Location Finder API-Key
DHL_API_KEY =

// Tracking-Backend, z. B. lokal im Simulator (Backend mit `npm run dev` starten):
API_BASE_URL = http:/$()/localhost:8787
// Produktiv z. B.: API_BASE_URL = https:/$()/api.paketlotse.de

// Nur mit kostenpflichtigem Apple-Developer-Account (Push-Benachrichtigungen):
// CODE_SIGN_ENTITLEMENTS = Paketlotse/Push.entitlements
